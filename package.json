{
  "name": "switchshot-adventures",
  "private": true,
  "version": "1.0.0",
  "description": "Switchshot Adventures — a portrait-first tap-to-shoot puzzle platformer for Little Joy Arcade.",
  "author": "jd4rider",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "vitest run tests/levels.test.ts"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
